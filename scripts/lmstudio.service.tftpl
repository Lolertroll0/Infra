[Unit]
Description=LM Studio Headless Local AI Server
After=network.target tailscaled.service

[Service]
Type=simple
User=${adminUser}
WorkingDirectory=/home/${adminUser}
ExecStart=/usr/local/bin/lms server start --port 1234 --cors --bind 0.0.0.0
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/${adminUser}/.local/bin:/home/${adminUser}/.cache/lm-studio/bin

[Install]
WantedBy=multi-user.target
