[Unit]
Description=LM Studio Headless Local AI Server
After=network.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=${adminUser}
WorkingDirectory=/home/${adminUser}
ExecStart=/usr/local/bin/lms server start --port 1234 --cors --bind 0.0.0.0
ExecStop=/usr/local/bin/lms server stop
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/${adminUser}/.local/bin:/home/${adminUser}/.lmstudio/bin

[Install]
WantedBy=multi-user.target
